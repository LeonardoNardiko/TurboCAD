<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">

  <!--[ Info ]------------------------------------------------------------------------->

  <name>TurboCAD</name>
  <description>Inspect native CAD files inside FreeCAD: Solid Edge (.par/.asm/.psm) and Autodesk Inventor (.ipt/.iam). Detects file type, reads the OLE2 structure (streams), CLSID and metadata without opening the source application.</description>
  <version>0.0.2</version>
  <date>2026-08-14</date>

  <!--[ Ecosystem Requirements ]-------------------------------------------------------->

  <freecadmin>1.0</freecadmin>
  <pythonmin>3.11</pythonmin>

  <!--[ Dependencies ]------------------------------------------------------------------>

  <depend type="python">olefile</depend>

  <!--[ Tags ]-------------------------------------------------------------------------->

  <tag>CAD</tag>
  <tag>Interoperability</tag>
  <tag>Solid Edge</tag>
  <tag>Inventor</tag>
  <tag>Inspection</tag>

